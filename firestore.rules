rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    // Admin status is granted via Firebase Auth custom claims, set with
    // `scripts/grant-admin.mjs grant <email>`. Avoids hardcoding emails in
    // either the client bundle or these rules.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ── Products: anyone can read; only admins can write ───────────────────
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Checkouts ──────────────────────────────────────────────────────────
    // Customers are anonymously signed in (request.auth.uid is set). New
    // checkouts must carry that UID and reads are gated by it — so a customer
    // can list/onSnapshot ONLY their own orders, never anyone else's PII.
    // Admins see everything (including legacy docs without userId).
    match /checkouts/{id} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.sessionId is string
                    && request.resource.data.sessionId.size() > 8
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0;
      allow get:    if isAdmin()
                    || (request.auth != null && resource.data.userId == request.auth.uid);
      allow list:   if isAdmin()
                    || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Client profiles ───────────────────────────────────────────────────
    // Doc id IS the (unguessable, localStorage) sessionId.
    //
    // get:  allowed by id — the Hub reads its own profile, and referral lookups
    //       need by-id reads. The id is a high-entropy secret, so a by-id read
    //       is effectively "you already know the key".
    // list: ADMIN ONLY — prevents enumerating every customer's name/phone/spend
    //       (the previous `read: if true` leaked all PII via a collection query).
    //       Aggregate affiliate stats now come from /api/affiliate-stats.
    //
    // Financial fields (totalSpent, purchaseCount) are server-only: incremented
    // by api/payment-callback.ts via the Admin SDK (which bypasses these rules).
    // The client may only GROW xp by a small bounded amount per write (daily
    // check-in ≤ 75) — it can no longer set xp to an arbitrary value.
    match /client_profiles/{sessionId} {
      allow get:    if true;
      allow list:   if isAdmin();
      allow create: if request.resource.data.sessionId == sessionId
                    && request.resource.data.sessionId.size() > 8
                    && request.resource.data.xp == 0
                    && request.resource.data.totalSpent == 0
                    && request.resource.data.purchaseCount == 0;
      allow update: if request.resource.data.sessionId == sessionId
                    && request.resource.data.sessionId.size() > 8
                    && request.resource.data.totalSpent == resource.data.totalSpent
                    && request.resource.data.purchaseCount == resource.data.purchaseCount
                    && request.resource.data.xp is int
                    && request.resource.data.xp >= resource.data.xp
                    && request.resource.data.xp <= resource.data.xp + 100;
      allow delete: if isAdmin();
    }

    // ── Coupons ───────────────────────────────────────────────────────────
    // Public can `get` by exact code (used when entering it at checkout)
    // but cannot `list` to enumerate every coupon — only admin can list.
    match /coupons/{id} {
      allow get:    if true;
      allow list:   if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ── Analytics: append-only, basic shape validation ────────────────────
    // Requires an authenticated caller (every visitor is anonymously signed in)
    // to stop fully unauthenticated spam. Accepts a server timestamp (the type
    // the client actually writes via serverTimestamp()) or a numeric epoch.
    match /analytics_events/{id} {
      allow create: if request.auth != null
                    && request.resource.data.type is string
                    && request.resource.data.type.size() < 100
                    && (request.resource.data.timestamp is timestamp
                        || request.resource.data.timestamp is number);
      allow read, update, delete: if isAdmin();
    }

    // ── Admin settings: admins only ────────────────────────────────────────
    match /admin_settings/{id} {
      allow read: if true;        // shipping/promo settings read by client
      allow write: if isAdmin();
    }

    // ── Admin audit log: admin write-only, append-only ────────────────────
    // Forensic trail of admin actions. Admins can read; nobody can update or
    // delete (append-only). Entries are written by src/lib/audit.ts.
    match /admin_audit/{id} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── Deny everything else ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
