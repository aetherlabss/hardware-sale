# ─── Vertex AI / Gemini ─────────────────────────────────────────────────────
# Server-side ONLY (do NOT prefix with VITE_; that would inline the value
# into the public JS bundle). All client AI calls go through /api/ai-proxy
# which lives in api/ai-proxy.ts and reads these vars.
VERTEX_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1

# ─── Google Maps Platform ──────────────────────────────────────────────────
# Server-side only. Used by /api/places.ts and /api/geocode.ts. Restrict the
# key in Google Cloud Console to your Vercel deployment IPs.
GOOGLE_MAPS_API_KEY=

# ─── MPesa Vodacom Mozambique ──────────────────────────────────────────────
# Register at https://developer.vodacom.co.mz
MPESA_API_HOST=https://openapi.m-pesa.com
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=

# ─── e-Mola (Tmcel) ────────────────────────────────────────────────────────
# Register at https://emola.co.mz/business
EMOLA_API_URL=
EMOLA_API_TOKEN=
EMOLA_MERCHANT_CODE=

# ─── Payment callback ─────────────────────────────────────────────────────
# Shared secret that MPesa / e-Mola include when calling /api/payment-callback.
# Generate with: openssl rand -hex 32
PAYMENT_CALLBACK_SECRET=

# ─── Firebase (server) ────────────────────────────────────────────────────
# Public Firebase config (apiKey/authDomain/projectId) lives in
# firebase-applet-config.json and is safe to commit — security comes from
# firestore.rules, not from key secrecy.
FIREBASE_API_KEY=

# REQUIRED for payments/rewards to work. The Admin SDK (api/_firebaseAdmin.ts)
# uses this service account to write to Firestore, bypassing security rules —
# which is exactly what confirming payments, granting XP, and decrementing stock
# need. WITHOUT THIS, /api/payment-callback, /api/create-order, the gateways and
# the security-health/affiliate endpoints will fail.
#   1. Firebase Console → Project Settings → Service accounts → Generate new key
#   2. base64 the JSON:  base64 -w0 serviceAccount.json
#   3. Paste the output here (single line). Local dev can instead point
#      GOOGLE_APPLICATION_CREDENTIALS at the JSON file path.
FIREBASE_SERVICE_ACCOUNT=
# Optional override (defaults to "hardware-sale")
# FIREBASE_PROJECT_ID=hardware-sale

# ─── API CORS allowlist (optional) ────────────────────────────────────────
# Comma-separated origins allowed to call /api/* from a browser. If unset,
# defaults to the production domain + localhost. See api/_security.ts.
# ALLOWED_ORIGINS=https://hardwaresale.co.mz,https://www.hardwaresale.co.mz

# ─── Upstash Redis (optional — for production-grade rate limiting) ────────
# Without these, the rate limiter falls back to a per-lambda in-memory store
# that resets on cold start. To survive coordinated abuse, sign up free at
# https://console.upstash.com, create a Redis DB, and paste the REST creds:
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx
